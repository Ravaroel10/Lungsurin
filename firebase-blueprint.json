{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Stores user profile data, including curation list and activity metrics.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "fullName": { "type": "string" },
        "username": { "type": "string" },
        "role": { "type": "string", "enum": ["USER", "ADMIN", "SELLER"] },
        "favorites": { "type": "array", "items": { "type": "string" } },
        "points": { "type": "number" },
        "streak": { "type": "number" },
        "lastActionDate": { "type": "string" },
        "address": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "isPremium": { "type": "boolean" },
        "premiumStatus": { "type": "string", "enum": ["none", "pending", "active"] },
        "premiumProofURL": { "type": "string" },
        "vouchers": { "type": "array", "items": { "type": "object" } },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "fullName", "role"]
    },
    "Product": {
      "title": "Product",
      "description": "Stores product data listed in the marketplace.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "sellerId": { "type": "string" },
        "sellerName": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "originalPrice": { "type": "number" },
        "category": { "type": "string" },
        "condition": { "type": "string" },
        "images": { "type": "array", "items": { "type": "string" } },
        "type": { "type": "string", "enum": ["CURATED", "UPCYCLED"] },
        "analysisType": { "type": "string", "enum": ["RESALE", "REPAIR", "UPCYCLE"] },
        "impact": {
          "type": "object",
          "properties": {
            "wasteReducedKg": { "type": "number" },
            "co2SavedKg": { "type": "number" }
          }
        },
        "aiCondition": {
          "type": "object",
          "properties": {
            "fabric": { "type": "string" },
            "stain": { "type": "string" },
            "damage": { "type": "string" },
            "fading": { "type": "string" }
          }
        },
        "aiReasoning": { "type": "string" },
        "aiConfidence": { "type": "number" },
        "rating": { "type": "number" },
        "stock": { "type": "number" },
        "isModerated": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "price", "category", "sellerId"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer orders for products.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "items": { "type": "array", "items": { "type": "object" } },
        "totalAmount": { "type": "number" },
        "status": { "type": "string", "enum": ["PROSES", "DIKIRIM", "SELESAI", "DIBATALKAN"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "items", "totalAmount", "status"]
    },
    "Conversation": {
      "title": "Conversation",
      "description": "Chat conversation between two participants (usually buyer and seller).",
      "type": "object",
      "properties": {
        "participants": { "type": "array", "items": { "type": "string" } },
        "lastMessage": { "type": "string" },
        "otherPartyName": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["participants"]
    },
    "Message": {
      "title": "Message",
      "description": "Individual message in a conversation.",
      "type": "object",
      "properties": {
        "text": { "type": "string" },
        "senderId": { "type": "string" },
        "senderType": { "type": "string", "enum": ["user", "seller", "ai"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["text", "senderId"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "User profile documents."
    },
    "products/{productId}": {
      "schema": "Product",
      "description": "Product documents accessible in the marketplace."
    },
    "orders/{orderId}": {
      "schema": "Order",
      "description": "Order records."
    },
    "conversations/{chatId}": {
      "schema": "Conversation",
      "description": "Top-level conversation metadata."
    },
    "conversations/{chatId}/messages/{messageId}": {
      "schema": "Message",
      "description": "Individual chat messages."
    }
  }
}
